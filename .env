# =============================================================================
# Factory Knowledge — environment configuration
# =============================================================================
# Copy this file to ".env" and adjust. Everything has a working default, so an
# empty .env (or no .env at all) still runs in retrieval-only mode.
#
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
#
# You can reuse the same OpenAI key as the Office Navigator kit.

# --- LLM ---------------------------------------------------------------------
# Paste your OpenAI key here to enable conversational, cited answers.
# Without it, the kit answers in retrieval-only mode (no spend).
OPENAI_API_KEY=

LLM_PROVIDER=openai

# gpt-4o-mini is cheap and capable. Upgrade to gpt-4o for higher quality.
CHAT_MODEL=gpt-4o-mini

# Low temperature = factual and deterministic, important for technical guidance.
TEMPERATURE=0.1

# --- Retrieval (RAG) ---------------------------------------------------------
# "keyword" = pure-Python BM25 (default, no install). "vector" = ChromaDB.
RETRIEVER=vector

# Used only when RETRIEVER=vector. OpenAI embedding model name.
EMBEDDING_MODEL=text-embedding-3-small

# How many document chunks to feed the model per answer.
TOP_K=5

# Chunking controls (characters). Bigger chunks = more context, less precision.
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Hallucination guardrail -------------------------------------------------
# Minimum retrieval score to trust a chunk; below this for ALL hits, the
# assistant abstains instead of answering. BM25 scores aren't normalized, so
# keep this low (e.g. 0.0 to disable, ~1.0 to require a real keyword match).
MIN_SCORE=

# --- Routing -----------------------------------------------------------------
# "keyword" = fast keyword scoring (default). "llm" = let the model classify.
ROUTER=keyword

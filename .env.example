# =============================================================================
# Database Knowledge Assistant — environment configuration
# =============================================================================
# Copy this file to ".env" and fill in what you need:
#
#   cp .env.example .env       (macOS/Linux, git-bash)
#   copy .env.example .env     (Windows cmd)
#
# NOTHING here is required. With an empty .env the app still runs — pick a
# provider in the sidebar and paste a key there, or point it at a local model.
# Keys typed into the sidebar are held in memory only and never written to disk.
#
# NEVER commit your real .env — it is already in .gitignore. Keep it that way.

# --- Provider ----------------------------------------------------------------
# Which backend answers questions. All are selectable in the UI at runtime;
# this only sets the startup default.
#   ollama | lmstudio | openai | anthropic | copilot | none
LLM_PROVIDER=ollama

# Local models — no key, no cloud, nothing leaves the machine.
# Start Ollama:    ollama serve      (then: ollama pull qwen2.5:3b)
# Start LM Studio: enable its local server on port 1234.
OLLAMA_HOST=http://localhost:11434
LMSTUDIO_HOST=http://localhost:1234/v1

# Cloud keys — optional. Leave blank and enter them in the sidebar instead.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Copilot uses browser device-flow sign-in from the sidebar.
# Do NOT paste a token here; each user signs in with their own account.

# Model to use at startup. Leave blank to pick from the live list in the UI —
# model lists are fetched from the provider, never hardcoded.
CHAT_MODEL=

# Low temperature keeps answers factual — important for technical guidance.
TEMPERATURE=0.1

# --- Retrieval ---------------------------------------------------------------
# keyword = pure-Python BM25, no install, instant start.
# vector  = ChromaDB embeddings, best quality (measured MRR 0.93).
# hybrid  = reciprocal rank fusion of both.
RETRIEVER=vector

# Embeddings for RETRIEVER=vector. nomic-embed-text runs locally under Ollama;
# text-embedding-3-small is the OpenAI equivalent.
EMBEDDING_MODEL=nomic-embed-text

# How many chunks to feed the model per answer.
TOP_K=5

# Chunking strategy: simple | recursive | semantic | metadata_aware
# metadata_aware scored best in eval/. Changing this triggers a ~90s re-index.
CHUNK_STRATEGY=metadata_aware
CHUNK_SIZE=800

# --- Grounding ---------------------------------------------------------------
# Chunks scoring below this are discarded BEFORE the model is called, so it
# cannot answer from weak evidence. Leave blank to auto-scale per retriever
# (vector 0.68, keyword 4.0, hybrid 0.0) — the scales are not comparable.
MIN_SCORE=
